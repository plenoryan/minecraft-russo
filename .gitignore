# Minecraft runtime logs and crash dumps
logs/
*.log
crash-reports/
hs_err_pid*.log
replay_recordings/
screenshots/

# Minecraft internal caches & transient files
.fabric/
.cache/
cache/
Servidor_Dedicado/libraries/
Servidor_Dedicado/versions/
usercache.json
usernamecache.json
session.lock
*.lock
*.tmp
*.bak

# MultiMC / UltimMC transient caches
Launcher/cache/
Launcher/instances/*/.minecraft/logs/
Launcher/instances/*/.minecraft/crash-reports/
Launcher/data/cache/
Launcher/data/metacache
Launcher/data/assets/
Launcher/data/instances/*/.minecraft/logs/
Launcher/data/instances/*/.minecraft/crash-reports/

# World saves (do not commit transient gameplay worlds)
**/saves/
**/backups/

# Java 17 portable runtime environment (recreatable via install_java17.ps1)
Java17/

# System and OS files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

cfr.jar
decompiled/
src/summary.txt

*.class

# Launcher instance NTFS junctions (mirrored from Instancia_Cliente)
Launcher/data/instances/*/.minecraft/kubejs/
Launcher/data/instances/*/.minecraft/resourcepacks/
Launcher/data/instances/*/.minecraft/shaderpacks/
Launcher/instances/*/.minecraft/kubejs/
Launcher/instances/*/.minecraft/resourcepacks/
Launcher/instances/*/.minecraft/shaderpacks/
Launcher/data/instances/*/natives/
Launcher/instances/*/natives/

# Distribution artifacts
dist/
docs/downloads/*.zip
.agents/
